{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": [
      "ES2023"
    ],
    "types": [
      "@cloudflare/workers-types"
    ],
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "paths": {
      "hono": [
        "./node_modules/hono"
      ],
      "hono/http-exception": [
        "./node_modules/hono/dist/types/http-exception.d.ts"
      ],
      "hono/body-limit": [
        "./node_modules/hono/dist/types/middleware/body-limit/index.d.ts"
      ],
      "hono/cookie": [
        "./node_modules/hono/dist/types/helper/cookie/index.d.ts"
      ],
      "hono/streaming": [
        "./node_modules/hono/dist/types/helper/streaming/index.d.ts"
      ],
      "zod": [
        "./node_modules/zod"
      ]
    }
  },
  "include": [
    "src/**/*.ts"
  ]
}

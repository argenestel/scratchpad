{
  "name": "scratchpad-worker",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "npm --prefix ../web run build && wrangler deploy",
    "db:migrate": "npm run db:migrate:local",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "hono": "^4.10.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.6.1",
    "@cloudflare/workers-types": "^5.20261104.1",
    "typescript": "^5.9.0",
    "vitest": "^4.1.0",
    "wrangler": "4.158.0"
  },
  "allowScripts": {
    "workerd@1.20261104.1": true,
    "sharp@0.35.5": true,
    "workerd@1.20261109.1": true,
    "esbuild@0.28.2": true
  }
}

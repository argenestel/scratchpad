# HTTP port inside the container; keep aligned with Compose's port mapping.
PORT=3000
# Browser-facing URL used to complete sign-in.
APP_URL=http://localhost:3000
# Persistent SQLite and application data directory inside the container.
DATA_DIR=/data
# Cookie signing + token encryption key (min 32 chars). Leave empty to auto-generate
# one and persist it to $DATA_DIR/secret. Generate your own: openssl rand -base64 48
APP_SECRET=
# ChatGPT browser OAuth callback port; the localhost redirect uses 1455.
OAUTH_CALLBACK_PORT=1455
# Model used by the Codex Responses harness.
DEFAULT_MODEL=gpt-6.1-sol
# Reasoning effort requested from the model.
REASONING_EFFORT=medium
# Reasoning summary shown as "thinking" in the margin: concise | detailed | auto
REASONING_SUMMARY=concise
# Optional imported Codex credentials; enable the read-only Compose mount too.
# CODEX_AUTH_FILE=/codex/auth.json
# Optional API-key fallback; leave unset to use your ChatGPT account.
# OPENAI_API_KEY=replace-with-your-api-key
# Maximum number of background agent jobs running concurrently.
JOB_CONCURRENCY=2
# Runtime mode (the dev override sets development).
NODE_ENV=production
# Built frontend directory served by the production server.
WEB_DIST=/app/web/dist
# Vite development proxy target (the dev override uses http://server:3000).
# VITE_API_PROXY=http://localhost:3000
